# Copiar a backend/.env (gitignoreado) y completar.
#
# Key del servicio de tags por LLM (#7). Es gratis y no pide tarjeta:
# https://aistudio.google.com/apikey
#
# Cada uno usa la suya. El limite diario del free tier es por proyecto, asi que
# compartir una key entre dos personas parte la cuota al medio. Ver BACKEND.md.
GEMINI_API_KEY = <own_api_key>

# Opcional: otro modelo, por defecto gemini-2.5-flash.
# GEMINI_MODEL = gemini-2.5-flash

# Opcional: timeout en segundos, por defecto 60. Subirlo si el archivo es grande.
# GEMINI_TIMEOUT = 120

# Solo hace falta si 'gh' no esta logueado en esta maquina: el servicio cae al
# 'gh' CLI como ultimo recurso, asi que con 'gh auth status' en verde no hay
# nada que configurar. Ver BACKEND.md.
#
# Token de GitHub con scope 'public_repo'. La API de busqueda de codigo rechaza
# los requests anonimos, asi que sin credencial el servicio no arranca.
#
#   cp .env.example .env && echo "GITHUB_TOKEN=$(gh auth token)" >> .env
GITHUB_TOKEN=

# Opcional: apunta el proxy a otra instancia (GitHub Enterprise, o un fake).
# GITHUB_API_URL=https://api.github.com
