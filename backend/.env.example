# Copiar a backend/.env (gitignoreado) y completar.
#
# Token de GitHub con scope 'public_repo'. La API de busqueda de codigo rechaza
# los requests anonimos, asi que sin esto el servicio no arranca.
#
#   cp .env.example .env && echo "GITHUB_TOKEN=$(gh auth token)" >> .env
GITHUB_TOKEN=

# Opcional: apunta el proxy a otra instancia (GitHub Enterprise, o un fake).
# GITHUB_API_URL=https://api.github.com
